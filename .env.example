# --- Supabase (SAME project as the conglomerate app: ibtadbwtrxglujkzqofs) ---
SUPABASE_URL=https://ibtadbwtrxglujkzqofs.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude (extraction). Haiku is the cheap default; override if you want. ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- QR pairing page protection (any random string; you pass it as ?token=) ---
QR_TOKEN=

# --- Guarded /send endpoint ("Angel for WhatsApp") ---
# Required to enable outbound sends. The Client Ops Autopilot must send the same
# value in the x-send-secret header. Leave blank to keep the bot read-only.
WA_SEND_SECRET=

# --- Client message email alerts ---
RESEND_API_KEY=
NOTIFY_EMAIL=jordanmorrisr@gmail.com

# --- Optional tuning ---
# DEBOUNCE_MS=8000      # how long a chat must be quiet before we summarize it
# LOG_LEVEL=warn        # pino level: warn | info | debug
# PORT is provided by Railway automatically
